# Railway injects DATABASE_URL automatically once you add a Postgres plugin to this service.
# For local development only, point it at a local Postgres:
DATABASE_URL=postgresql://user:password@localhost:5432/aigp_dev

# Any long random string. Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# The 4-digit (or longer) code trainers enter to reach the dashboard.
TRAINER_CODE=2468

# --- Email (optional) ---
# Works with any SMTP provider: Gmail (with an app password), Resend, SendGrid, Postmark, Mailgun, etc.
# Leave these unset to run with email sending disabled (the app still works; PDFs can be downloaded manually).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

NODE_ENV=production
